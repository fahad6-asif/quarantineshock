{
  "name": "quarantineshock",
  "private": true,
  "version": "0.1.0",
  "description": "Notice in, rules out, shipments flagged.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/run-api.mjs",
    "dev:web": "npm --prefix frontend run dev",
    "test": "node scripts/run-api.mjs --pytest",
    "e2e": "npm --prefix frontend run e2e"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
