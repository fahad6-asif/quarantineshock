# QuarantineShock configuration. Copy to .env (scripts/setup.py does this) and fill in keys.
# Never commit .env.

# auto = cache -> Gemini -> OpenRouter -> cached fallback | gemini | openrouter | replay (cache only, no network)
LLM_PROVIDER=auto

GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_STRONG=gemini-3.5-flash
# used automatically if the main model is overloaded or times out
GEMINI_MODEL_BACKUP=gemini-2.5-flash
GEMINI_RPM=10
GEMINI_TIMEOUT_S=40

OPENROUTER_API_KEY=
# Cheap backup used automatically when Gemini fails or does not answer (about 0.04 USD in / 0.17 USD out per 1M tokens)
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_RPM=20

# Only used if the radius cannot be found in sources/ (it is: CDFA 3417(b)(3) says 4.5 miles)
QUARANTINE_RADIUS_MILES=4.5

NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional tracing (no-op when empty)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
